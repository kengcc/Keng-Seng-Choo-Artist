    "validate": "node scripts/validate-output.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "turndown": "^7.2.2"
  }
}
