---
import Base from '../layouts/Base.astro';
import ArtworkGrid from '../components/ArtworkGrid.astro';
import ArticleList from '../components/ArticleList.astro';
import works from '../data/artworks.json';
import legacyUrls from '../data/legacy-urls.json';
import HomePainting from '../components/HomePainting.astro';
import { href, publicArticles } from '../lib/site';
import { artist } from '../data/artist';
const hero = works.find(work => work.slug === 'mirror-330')!;
const selected = [works.find(w => w.title === 'Freedom')!, works.find(w => w.title === 'Village Pigeons')!, works.find(w => w.title === 'Kampung Life')!];
const articles = await publicArticles();
const stories = [articles.find(a => a.data.slug === 'younie-when-the-south-wind-is-blowing-2026')!, articles.find(a => a.data.slug === 'maybank-of-moments-and-memories-2019')!, articles.find(a => a.data.wordpressId === 43)!];
---
<Base image={hero.image}>
  <script define:vars={{ queryRoutes: Object.fromEntries(Object.entries(legacyUrls).filter(([key]) => key.startsWith('/?p=')).map(([key,value]) => [key.slice(4), href(value)])) }}>
    const postId = new URLSearchParams(window.location.search).get('p');
    if (postId && queryRoutes[postId]) window.location.replace(queryRoutes[postId]);
  </script>
  <section class="hero wrap">
    <div class="hero-copy"><p class="eyebrow"><span class="small-line"></span> MALAYSIAN ARTIST · 龚明金</p><h1 class="artist-hero-name">Keng<br /><em class="given-name">Seng Choo</em></h1><p class="hero-lead">The colour of everyday life.</p><p class="hero-intro">Figures, pigeons and the poetry of Malaysian life.<br /><span lang="zh">人物、鸽子与乡情，化作画布上的色彩。</span></p><div class="hero-actions"><a class="button" href={href('/works/')}>Explore the paintings</a><a class="text-link" href={href('/about/')}>Meet the artist</a></div><p class="hero-signature">For art, no regrets.</p></div>
    <HomePainting />
  </section>
  <section class="artist-credentials wrap" aria-label="Artist credentials"><a href={href('/about/')}><strong>NAFA · 1965</strong><span>Nanyang Academy of Fine Arts graduate</span></a><a href={href('/about/#career')}><strong>New York · 1970</strong><span>International Art Show Silver Medal</span></a><a href={href('/about/#recognition')}><strong>Institutionally collected</strong><span>Named in Bank Negara Malaysia’s collection</span></a></section>

  <section class="home-artist wrap"><img src={href(artist.portrait)} alt="Portrait of Keng Seng Choo 龚明金" width="220" height="220" loading="lazy" /><div><p class="eyebrow">MEET THE ARTIST · <span lang="zh">认识画家</span></p><h2>A life devoted to art.</h2><p>Born in Alor Setar in 1945 and a Nanyang Academy of Fine Arts graduate of 1965, Keng Seng Choo brings a distinctive personal voice to Malaysian painting. His figures, family scenes and pigeons connect colour with the poetry of everyday life.</p><p lang="zh">龚明金以人物、乡情与鸽子题材，呈现马来西亚生活中的色彩与情感。</p><a class="text-link" href={href('/about/')}>Read his story ↗</a></div></section>

  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">A CLOSER LOOK</p><h2>Selected artworks</h2></div><a class="text-link" href={href('/works/')}>All artworks ↗</a></div><ArtworkGrid works={selected} compact /></section>

  <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">WORDS &amp; PERSPECTIVES</p><h2>Exhibitions &amp; stories</h2></div><a class="text-link" href={href('/articles/')}>All articles &amp; events ↗</a></div><ArticleList entries={stories} /><nav class="section-jumps" aria-label="Explore the artist archive"><a href={href('/exhibitions/')}>Explore the exhibition timeline</a><a href={href('/collections/')}>Collections &amp; galleries</a><a href={href('/interviews/')}>Press &amp; interviews</a></nav></section>
  <section class="enquiry-band"><div class="wrap enquiry-inner"><div><p class="eyebrow">CONTINUE THE CONVERSATION</p><h2>Find a work that speaks to you.</h2><p>Enquire about a painting, its details or current availability.</p></div><div class="enquiry-actions"><a class="button" href={href('/contact/')}>Artwork enquiries ↗</a><a class="text-link" href={href('/collectors/')}>A guide to collecting ↗</a></div></div></section>
</Base>
