---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { pageById, publicArticles, href } from '../lib/site';
import { articleSection } from '../lib/editorial';
import ArticleList from '../components/ArticleList.astro';
const page = await pageById(44); const { Content } = await render(page);
const entries = (await publicArticles()).filter(p => articleSection(p) === 'press' && !p.data.duplicateOf);
---
<Base title="Press & Interviews 专访"><section class="page-heading wrap"><p class="eyebrow">PRESS &amp; INTERVIEWS · <span lang="zh">报道与专访</span></p><h1>In conversation.</h1><p>Interviews, reviews and press perspectives on the artist and his work.</p><a class="text-link" href={href('/articles/')}>All articles &amp; events ↗</a></section><section class="wrap section"><ArticleList entries={entries} /><details class="original-record"><summary>Original interview index and scans</summary><div class="prose interview-intro"><Content /></div></details></section></Base>
