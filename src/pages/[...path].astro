---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { href } from '../lib/site';
export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  return pages.filter(p => !['/works/','/contact/','/interviews/'].includes(p.data.route))
    .map(entry => ({ params: { path: entry.data.route.replace(/^\/|\/$/g,'') }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const isAbout = entry.data.wordpressId === 8;
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class:list={['content-page wrap', { 'about-page': isAbout }]}><header class="page-heading"><p class="eyebrow">{isAbout ? 'THE ARTIST' : entry.data.wordpressId === 227 ? 'COLLECTION & CATALOGUE' : 'WORDS & PERSPECTIVES'}</p><h1>{isAbout ? 'Keng Seng Choo' : entry.data.title}</h1>{isAbout && <p class="artist-name-zh" lang="zh">龚明金</p>}</header><div class="prose">{isAbout && <p class="archive-note">Biography preserved from the original artist website.</p>}<Content /></div><footer class="article-end"><span lang="zh">以艺术为伴</span><a class="text-link" href={href('/works/')}>Explore the works ↗</a></footer></article>
</Base>
