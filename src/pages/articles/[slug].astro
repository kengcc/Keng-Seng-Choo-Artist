---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publicArticles, formatDate, href } from '../../lib/site';
import { articleSection, sectionLabels, languageLabel } from '../../lib/editorial';
export async function getStaticPaths() {
  const entries = await publicArticles();
  return entries.map(entry => ({ params: { slug: entry.data.slug }, props: { entry,
    canonicalPath:entry.data.duplicateOf ? entries.find(e=>e.data.wordpressId===entry.data.duplicateOf)?.data.route : undefined } }));
}
const { entry, canonicalPath } = Astro.props;
const { Content } = await render(entry);
const canonical = Astro.site ? new URL(href(canonicalPath || entry.data.route),Astro.site) : undefined;
const firstImage = entry.body?.match(/\]\((\/media\/[^\s)]+)/)?.[1];
const articleId = canonical ? `${canonical.href}#article` : undefined;
const extra = canonical ? [{ '@type':'Article', '@id':articleId, headline:entry.data.title,
  description:entry.data.summary, datePublished:entry.data.date,
  inLanguage:entry.data.language==='en-zh'?['en','zh']:entry.data.language,
  mainEntityOfPage:{'@id':`${canonical.href}#page`},
  about:{'@id':`${new URL(href('/'),Astro.site).href}#artist`},
  ...(firstImage?{image:new URL(href(firstImage),Astro.site).href}:{}),
}] : [];
---
<Base title={entry.data.title} description={entry.data.summary} image={firstImage} canonicalPath={canonicalPath} lang={entry.data.language==='zh'?'zh':'en'} mainEntity={articleId?{'@id':articleId}:undefined} extraSchema={extra}>
  <article class="article-page wrap"><header class="article-heading"><a class="back-link" href={href('/articles/')}>← Articles &amp; events</a><p class="eyebrow">{sectionLabels[articleSection(entry)]} · {languageLabel(entry.data.language)} · Published <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time></p><h1>{entry.data.title}</h1>{entry.data.eventStart && <p class="event-when">Event: {formatDate(entry.data.eventStart)}{entry.data.eventEnd && ` – ${formatDate(entry.data.eventEnd)}`} · {entry.data.eventVenue}</p>}<p class="archive-note">From the archive. The date and writing reflect the original record.</p></header><div class="prose"><Content /></div>{entry.data.duplicateOf && <aside class="source-note">This archive entry closely matches <a href={href('/articles/artist-captures-peaceful-ways-of-the-pigeons/')}>another version of the same article</a>. Both original records are preserved.</aside>}<footer class="article-end"><span lang="zh">龚明金</span><a class="text-link" href={href('/articles/')}>More articles &amp; events ↗</a></footer></article>
</Base>
