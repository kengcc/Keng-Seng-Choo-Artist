---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { publicArticles, formatDate, href } from '../../lib/site';
export async function getStaticPaths() {
  return (await publicArticles()).map(entry => ({ params: { slug: entry.data.slug }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---
<Base title={entry.data.title} description={entry.data.summary}>
  <article class="article-page wrap"><header class="article-heading"><a class="back-link" href={href('/articles/')}>← Back to the archive</a><p class="eyebrow">{entry.data.kind.toUpperCase()} · <time datetime={entry.data.date}>{formatDate(entry.data.date)}</time></p><h1>{entry.data.title}</h1><p class="archive-note">From the archive. The date and writing reflect the original record.</p></header><div class="prose"><Content /></div>{entry.data.duplicateOf && <aside class="source-note">This archive entry closely matches <a href={href('/articles/artist-captures-peaceful-ways-of-the-pigeons/')}>another version of the same article</a>. Both original records are preserved.</aside>}<footer class="article-end"><span lang="zh">龚明金</span><a class="text-link" href={href('/articles/')}>Continue exploring the archive ↗</a></footer></article>
</Base>
