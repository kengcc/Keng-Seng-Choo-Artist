---
import Base from '../../layouts/Base.astro';
import ArticleList from '../../components/ArticleList.astro';
import { publicArticles, pageById, href } from '../../lib/site';
const entries = [...(await publicArticles()).filter(e => !e.data.duplicateOf), await pageById(217)].sort((a,b) => b.data.date.localeCompare(a.data.date));
const picks = [43,208,104].map(id => entries.find(e => e.data.wordpressId === id)!);
---
<Base title="Articles & Events — Exhibitions, Press & Writing">
  <section class="page-heading wrap"><p class="eyebrow">ARTICLES &amp; EVENTS · <span lang="zh">文章与活动</span></p><h1>Stories behind the art.</h1><p>Explore exhibitions, press coverage, interviews and writing.<br />Original articles in English and Chinese, preserved with their publication dates.</p></section>
  <section class="wrap archive-intro"><h2>A starting point</h2><div class="story-links featured-stories">{picks.map((entry,i) => <a href={href(entry.data.route)}><span class="eyebrow">{['MEET THE ARTIST','A PAST EXHIBITION','AN ARTWORK STORY'][i]}</span><strong>{entry.data.title}</strong><span>Read the original article ↗</span></a>)}</div><a class="text-link" href={href('/about/artist-statement/')}>The artist’s statement · English &amp; 中文 ↗</a></section>
  <section class="wrap archive-section" data-archive><div class="archive-toolbar"><div class="filter-tabs" role="group" aria-label="Filter articles"><button data-filter="all" aria-pressed="true">All</button><button data-filter="events" aria-pressed="false">Exhibitions &amp; events</button><button data-filter="press" aria-pressed="false">Press &amp; interviews</button><button data-filter="writing" aria-pressed="false">Writing &amp; reflections</button><button data-filter="artworks" aria-pressed="false">Artwork stories</button><button data-filter="updates" aria-pressed="false">Website notes</button></div><div class="archive-controls"><label class="archive-search"><span class="sr-only">Search articles and events</span><input type="search" placeholder="Search title, year or venue…" /><span aria-hidden="true">⌕</span></label><label class="archive-language"><span class="sr-only">Article language</span><select aria-label="Article language"><option value="all">All languages</option><option value="en">English</option><option value="zh">中文</option></select></label></div></div><p class="archive-count" aria-live="polite">{entries.length} records</p><ArticleList entries={entries} /><p class="no-results" hidden>No records match these filters. Try another keyword, language or category.</p><p class="archive-explanation">Publication dates describe the original articles. Confirmed event dates are shown separately. Original duplicate records remain accessible through their historical links.</p></section>
</Base>
