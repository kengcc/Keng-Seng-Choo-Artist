---
import { href } from '../lib/site';
import { artworkPath, artworkLabel } from '../lib/seo';
interface Work { id: string; title: string | null; titleZh?: string; descriptiveLabel: string; image: string; thumbnail?: string; labelType?: string; series: string; sourcePictureId?: number; slug?: string; width?: number; height?: number; }
interface Props { works: Work[]; compact?: boolean; }
const { works, compact = false } = Astro.props;
---
<div class:list={['art-grid', { compact }]}>
  {works.map((work, index) => <figure class="artwork">
    <button class="artwork-image" data-viewer-src={href(work.image)} data-viewer-caption={artworkLabel(work)} aria-label={`View ${work.descriptiveLabel}`}>
      <img src={href(work.thumbnail || work.image)} alt={artworkLabel(work)} width={work.width || 800} height={work.height || 900} loading="lazy" decoding="async" />
      <span class="view-art" aria-hidden="true">View artwork ↗</span>
    </button>
    <figcaption><div><a href={href(artworkPath(work))}>{work.title || work.descriptiveLabel}{work.titleZh && <> · <span lang="zh">{work.titleZh}</span></>}</a></div><span class="art-number">{String(index + 1).padStart(2,'0')}</span></figcaption>
  </figure>)}
</div>
