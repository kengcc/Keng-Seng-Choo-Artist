---
import references from '../data/references.json';
import { formatDate } from '../lib/site';
const { ids = [] } = Astro.props;
const selected = ids.map((id: string) => {
  const source = references.find(source => source.id === id);
  if (!source) throw new Error(`Unknown reference: ${id}`);
  return source;
});
---
{selected.length > 0 && <aside class="reference-panel" aria-label="References">
  <h2>Sources &amp; further reading</h2>
  <ul>{selected.map(source => <li><a href={source.url}>{source.title}</a><span>{source.publisher} · Link checked {formatDate(source.checkedAt)}</span></li>)}</ul>
</aside>}
