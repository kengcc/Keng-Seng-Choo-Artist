---
import '../styles/global.css';
import { href } from '../lib/site';
import { artist } from '../data/artist';
import { structuredData } from '../lib/seo';
interface Props { title?: string; description?: string; image?: string; imageAlt?: string; noindex?: boolean; lang?: string; pageType?: string; canonicalPath?: string; mainEntity?: Record<string, unknown>; extraSchema?: Record<string, unknown>[]; }
const { title, description = artist.description, image = artist.socialImage,
  imageAlt = 'Painting by Malaysian artist Keng Seng Choo 龚明金', noindex = false, lang = 'en',
  pageType = 'WebPage', canonicalPath, mainEntity, extraSchema = [] } = Astro.props;
const fullTitle = title ? `${title} · Keng Seng Choo` : 'Keng Seng Choo 龚明金 | Malaysian Artist & Oil Paintings';
const canonical = Astro.site ? new URL(canonicalPath ? href(canonicalPath) : Astro.url.pathname, Astro.site) : undefined;
const graph = Astro.site && canonical && !noindex ? structuredData({site:Astro.site, canonical, title:fullTitle, description, pageType, mainEntity, extra:extraSchema}) : undefined;
const current = Astro.url.pathname;
const nav = [['Works','/works/'],['About','/about/'],['Collectors','/collectors/'],['Archive','/articles/'],['Contact','/contact/']];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5ef" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      // Apply the saved preference before the first paint, even if storage is blocked.
      (() => {
        let saved;
        try { saved = localStorage.getItem('ksc-theme'); } catch {}
        const theme = saved === 'light' || saved === 'dark' ? saved :
          (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme === 'dark' ? '#191f1d' : '#f7f5ef');
      })();
    </script>
    <title>{fullTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={extraSchema.some(item => item['@type'] === 'Article') ? 'article' : 'website'} />
    <meta property="og:site_name" content="Keng Seng Choo 龚明金" />
    <meta property="og:locale" content="en_MY" />
    <meta property="og:locale:alternate" content="zh_CN" />
    {canonical && <meta property="og:url" content={canonical} />}
    {image && Astro.site && <meta property="og:image" content={new URL(href(image), Astro.site)} />}
    {image && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && Astro.site && <meta name="twitter:image" content={new URL(href(image), Astro.site)} />}
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    {Astro.site && <link rel="alternate" type="application/rss+xml" title="Keng Seng Choo archive" href={href('/feed.xml')} />}
    {graph && <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')} />}
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a href={href('/')} class="wordmark" aria-label="Keng Seng Choo home">
        <span>KENG SENG CHOO</span><span class="wordmark-zh" lang="zh">龚明金</span>
      </a>
      <div class="header-actions">
        <button class="theme-toggle" type="button" role="switch" aria-label="Dark mode" aria-checked="false" hidden>
          <svg class="theme-sun" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          <svg class="theme-moon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 15.3A8.5 8.5 0 0 1 8.7 4 8.5 8.5 0 1 0 20 15.3Z" /></svg>
          <span class="theme-label">Light</span>
        </button>
        <button class="menu-toggle" aria-controls="primary-nav" aria-expanded="false">Menu <span aria-hidden="true">＋</span></button>
      </div>
      <nav id="primary-nav" class="primary-nav" aria-label="Main navigation">
        {nav.map(([label,path]) => <a href={href(path)} aria-current={current.startsWith(href(path)) ? 'page' : undefined}>{label}</a>)}
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap">
      <div><a href={href('/')} class="footer-name">Keng Seng Choo <span lang="zh">龚明金</span></a><p>For art, no regrets. <span lang="zh">因为艺术，无悔无憾。</span></p></div>
      <div class="footer-links"><a href={href('/interviews/')}>Interviews</a><a href={href('/exhibitions/')}>Exhibitions</a><a href={href('/contact/')}>Get in touch ↗</a></div>
      <p class="copyright">© {new Date().getFullYear()} Keng Seng Choo. Artwork and original materials retain their respective credits.</p>
    </footer>
    <dialog class="art-dialog" aria-label="Artwork viewer">
      <div class="viewer-bar"><span class="viewer-count"></span><button class="viewer-close" aria-label="Close artwork viewer">Close <span aria-hidden="true">×</span></button></div>
      <div class="viewer-image"><button class="viewer-prev" aria-label="Previous image">←</button><img alt="" /><button class="viewer-next" aria-label="Next image">→</button></div>
      <p class="viewer-caption"></p>
    </dialog>
    <script>
      import '../scripts/interactions';
    </script>
  </body>
</html>
